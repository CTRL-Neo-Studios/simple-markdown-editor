		"@nuxtjs/i18n": "10.0.3",
		"@vueuse/nuxt": "13.5.0",
		"codemirror": "^6.0.2",
		"nuxt": "^4.0.1",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
